# Get a free API key from https://console.cloud.google.com/apis/credentials
# with the "YouTube Data API v3" enabled.
VITE_YOUTUBE_API_KEY=

# Your channel's ID (already filled in for Johnres Lab).
VITE_YOUTUBE_CHANNEL_ID=UC7fEBAOabB0JGpnzAx7COGA

# Firebase config (optional) — enables live blog/projects/downloads content from the
# admin panel, plus lightweight page-view analytics. Without these, the site falls back
# to the static content in src/data/*.ts and simply skips analytics.
# Get these from Firebase Console → Project Settings → General → Your apps.
# Use the SAME Firebase project as the johnreslab-admin app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
